MONGO_INITDB_ROOT_USERNAME=vta_user
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_INITDB_DATABASE=voice_training

MONGODB_URI=mongodb://vta_user:change_me@mongodb:27017/voice_training?authSource=admin

KEYCLOAK_REALM_URL=http://keycloak:8080/realms/voice-training/protocol/openid-connect/certs
# Browser-issued tokens usually use localhost issuer in local dev.
KEYCLOAK_EXPECTED_ISSUER=http://localhost:8080/realms/voice-training
KEYCLOAK_EXPECTED_AUDIENCES=account

POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change_me
POSTGRES_DB=keycloak

SERVER_PORT=3000
ANALYZE_MAX_BODY_BYTES=1048576

# LLM provider routing (rule | openai | openrouter | groq)
LLM_PROVIDER=rule
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
VAD_PROVIDER=silero
ASR_PROVIDER=vosk_remote
VOSK_SERVER_URL=ws://vosk:2700
PROVIDER_STRICT=true

# Frontend (web-demo/.env)
# VITE_API_URL=http://localhost:3000
# VITE_KEYCLOAK_URL=http://localhost:8080
# VITE_KEYCLOAK_REALM=voice-training
# VITE_KEYCLOAK_CLIENT_ID=your_client_id
