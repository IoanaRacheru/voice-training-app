MONGO_INITDB_ROOT_USERNAME=vta_user
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_INITDB_DATABASE=voice_training

MONGODB_URI=mongodb://vta_user:change_me@mongodb:27017/voice_training?authSource=admin

KEYCLOAK_REALM_URL=http://keycloak:8080/realms/voice-training/protocol/openid-connect/certs

POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change_me
POSTGRES_DB=keycloak

SERVER_PORT=3000

